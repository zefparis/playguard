# ── Vercel Edge proxy (api/proxy.ts) — server-side only, NEVER expose ────────
# These vars MUST be set in the Vercel project settings, NOT in any committed
# .env file. They are read by the edge function at runtime.
PG_API_URL=https://hybrid-vector-api-m5xt.onrender.com
PG_API_KEY=replace-with-real-key-from-1password
PG_TENANT_ID=playguard-demo

# ── PlayGuard backend (backend/.env) ──────────────────────────────────────────
# Set to 21 (not 18) to compensate for AWS Rekognition over-aging bias on children
# VERIFY_AGE verdict triggers when AgeRange.Low < 25 and face is not already MINOR
PG_AGE_THRESHOLD=21
